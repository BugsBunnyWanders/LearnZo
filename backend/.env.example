# Application Settings
PROJECT_NAME="LearnZo Backend"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Settings
# Standard synchronous PostgreSQL connection string using psycopg3
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/learnzo"

# Logging Settings
LOG_LEVEL="INFO"

